<Window x:Class="AdminClientWpf.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdminClientWpf.ViewModels"
        Title="DnD Admin • Dashboard" Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#161028"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1430"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#22182F"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E182C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1E3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Admin Dashboard" Style="{StaticResource TitleText}"/>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="15"
                           Text="User management and administration"/>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                           Text="{Binding AdminLabel}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Refresh" Width="130" Margin="0,0,12,0" Command="{Binding RefreshCommand}"/>
                <Button Content="🚪 Logout" Width="130" Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Status/Error Messages -->
        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="12" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" Text="⚠️ Error"/>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="12" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
                Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="✓ Success"/>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                           Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Users Table -->
            <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="0">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" IsReadOnly="True"/>
                        <DataGridComboBoxColumn Header="Role"
                                                SelectedItemBinding="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Width="110"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat=HH:mm}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right Panel: User Details -->
            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <!-- User Details Card -->
                <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="User Details" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource HintText}" Text="Email"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold"
                                       Text="{Binding SelectedUser.Email, FallbackValue='No user selected'}"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource HintText}" Text="Username"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextBrush}"
                                       Text="{Binding SelectedUser.Username, FallbackValue='—'}"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource HintText}" Text="Role"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedUser.Role}" Margin="0,8,0,0" Padding="12,8"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <CheckBox Content="Active User" IsChecked="{Binding SelectedUser.IsActive}" Padding="6,0,0,0" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="💾 Save Role" Width="auto" MinWidth="120" Command="{Binding UpdateRoleCommand}" Padding="12,8" Margin="0,0,12,0"/>
                            <Button Content="💾 Save Status" Width="auto" MinWidth="120" Command="{Binding UpdateStatusCommand}" Padding="12,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status Messages Card -->
                <Border Margin="0,16,0,0" CornerRadius="14" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}"/>
                </Border>

                <Border Margin="0,16,0,0" CornerRadius="14" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16"
                        Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
